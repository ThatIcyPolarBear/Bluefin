# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=Bluefin

# Make this the same as your github username/organisation
REPO_ORGANIZATION="ThatIcyPolarBear"

IMAGE_DESC="The next generation Linux workstation, designed for reliability, performance, and sustainability."
IMAGE_KEYWORDS="bootc,fedora,atomic,silverblue,workstation"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/ThatIcyPolarBear/Bluefin/main/logo.svg"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
